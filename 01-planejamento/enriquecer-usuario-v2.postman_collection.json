    {
      "name": "4 - Diagnósticos (8 iterações, sem arquivo de dados)",
      "item": [
        {
          "name": "4.1 Gerar diagnóstico",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.variables.get('baseUrl');",
                  "const token = pm.environment.get('token');",
                  "const meses = ['2026-09', '2026-10'];",
                  "const idx = pm.info.iteration;",
                  "const todas = [];",
                  "",
                  "function buscar(i) {",
                  "  if (i >= meses.length) {",
                  "    todas.sort((a, b) => new Date(a.data) - new Date(b.data));",
                  "    pm.environment.set('idTreino', todas[idx].id_treino);",
                  "    return;",
                  "  }",
                  "  pm.sendRequest({",
                  "    url: base + '/history/sessions?mes=' + meses[i],",
                  "    method: 'GET',",
                  "    header: { 'Authorization': 'Bearer ' + token },",
                  "  }, (err, res) => {",
                  "    if (!err && res.code === 200) todas.push(...res.json().sessoes);",
                  "    buscar(i + 1);",
                  "  });",
                  "}",
                  "buscar(0);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('diagnóstico criado', () => pm.response.to.have.status(201));",
                  "pm.test('tem score', () => pm.expect(pm.response.json().diagnostico.score_geral).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{idTreino}}/diagnostics/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{idTreino}}",
                "diagnostics",
                "generate"
              ]
            }
          }
        }
      ]
    }
